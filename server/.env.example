# ==============================================================================
# ExamPro Backend Production Environment Configuration Template
# Copy this file to .env and replace placeholder values with your real credentials.
# NEVER commit your actual .env file with secrets into version control!
# ==============================================================================

# Server Port (Render sets this dynamically via $PORT)
PORT=5000

# Environment Mode ('production' or 'development')
NODE_ENV=production

# MongoDB Connection String (MongoDB Atlas or local instance)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/exampro?retryWrites=true&w=majority

# Secret key used for signing JWT authentication tokens
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string

# Allowed Frontend Origins for CORS & Secure HTTP-only cookies
# In production, set to your Vercel URL (e.g. https://your-exampro.vercel.app)
# Multiple origins can be comma-separated: https://your-exampro.vercel.app,http://localhost:5173
CLIENT_URL=https://your-exampro.vercel.app

# Shared exam access password required for candidates to unlock test sessions
EXAM_ACCESS_PASSWORD=exam2024

# Initial Administrator Seed Account (created on first run/seed)
ADMIN_EMAIL=admin@exampro.com
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=ExamPro Admin
